      <c:url var="navTarget" value="/wiring"/>
      <li><a href="<c:out value="${navTarget}"/>" data-nav-target="/wiring"
          ${sitePagePath eq '/wiring' ? 'aria-current="page"' : ''}>Nối dây</a></li>
