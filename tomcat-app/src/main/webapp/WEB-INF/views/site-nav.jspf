      <c:url var="navTarget" value="/pages/lap-rap.html"/>
      <li><a href="<c:out value="${navTarget}"/>" data-nav-target="/pages/lap-rap.html"
          ${sitePagePath eq '/pages/lap-rap.html' ? 'aria-current="page"' : ''}>Lắp ráp</a></li>
      <c:url var="navTarget" value="/designs"/>
      <li><a href="<c:out value="${navTarget}"/>" data-nav-target="/designs"
          ${sitePagePath eq '/designs' ? 'aria-current="page"' : ''}>Xưởng thiết kế</a></li>
    </ul>
  </details>
  <details class="site-nav-group" data-nav-group="practice" data-nav-role="PUBLIC">
