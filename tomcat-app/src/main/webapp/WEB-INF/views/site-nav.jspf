          ${sitePagePath eq '/wiring-support' ? 'aria-current="page"' : ''}>Hỗ trợ nối dây</a></li>
      </c:if>
      <c:if test="${empty sessionScope.user or not sessionScope.user.admin}">
      <c:url var="navTarget" value="/diagnosis"/>
      <li><a href="<c:out value="${navTarget}"/>" data-nav-target="/diagnosis"
          ${sitePagePath eq '/diagnosis' ? 'aria-current="page"' : ''}>Luyện chẩn đoán</a></li>
