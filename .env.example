# Năm giá trị này được truyền vào Tomcat qua ô VM options của IntelliJ, dạng:
#   -DDB_HOST=127.0.0.1 -DDB_PORT=3306 -DDB_NAME=robot_assembly_lab -DDB_USER=... -DDB_PASSWORD=...
# META-INF/context.xml đọc chúng qua ${DB_HOST}... để tạo connection pool.
# Tomcat không tự đọc file .env; file này chỉ để ghi nhớ giá trị cần điền.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=robot_assembly_lab
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
